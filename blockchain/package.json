{
  "name": "@agentguard/blockchain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat build",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network botchainTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network botchainMainnet",
    "check:testnet": "hardhat run scripts/check-deployment.ts --network botchainTestnet",
    "check:mainnet": "hardhat run scripts/check-deployment.ts --network botchainMainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@openzeppelin/contracts": "5.4.0",
    "@types/mocha": "^10.0.10",
    "dotenv": "16.6.1",
    "hardhat": "^3.18.0",
    "typescript": "5.9.3"
  }
}

BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
BOTCHAIN_MAINNET_RPC_URL=https://rpc.botchain.ai

# Dedicated low-value deployment wallet only. Never use a personal wallet.
DEPLOYER_PRIVATE_KEY=

# Public owner of the AgentGuard contract. This wallet has the emergency pause authority.
CONTRACT_OWNER_ADDRESS=0x1905B29C6F01eDe290010DB081A6ad0Ba78A1a91

# Mainnet deployment remains blocked unless this explicit release-gate flag is set.
ALLOW_MAINNET_DEPLOYMENT=false

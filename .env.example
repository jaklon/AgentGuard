# Runtime
APP_ENV=development
LOG_LEVEL=INFO
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
API_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=16384

# Active BOT Chain network (public values). Production is mainnet-only.
BOTCHAIN_NETWORK=mainnet
BOTCHAIN_NETWORK_NAME=BOT Chain Mainnet
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
BOTCHAIN_CHAIN_ID=677
BOTCHAIN_EXPLORER_URL=https://scan.botchain.ai
BOTCHAIN_FAUCET_URL=
BOTCHAIN_BUNDLER_URL=
BOTCHAIN_ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
BOTCHAIN_CONTRACT_DEPLOYMENT_BLOCK=24347779
BOTCHAIN_CONTRACT_ADDRESS=0xae49e0dFae28d43e149b09c4240CbA2F378A1dd6

# Mobile wallet connection. Create this in Reown Cloud and allowlist the exact app origins.
# This identifier is embedded in the frontend bundle; keep it in .env, not source code.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Persistence
DATABASE_URL=sqlite:///./backend/data/agentguard.db

# AI. llama.cpp is internal-only and serves Qwen3-4B-Instruct-2507 Q4_K_M.
AI_PROVIDER=llama_cpp
AI_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=http://llm:8080
LOCAL_LLM_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_THREADS=3
MODEL_TIMEOUT_SECONDS=60

# Caddy
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

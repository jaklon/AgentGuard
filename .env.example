# Runtime
APP_ENV=development
LOG_LEVEL=INFO
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
API_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=16384

# BOT Chain testnet (public values)
BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
BOTCHAIN_TESTNET_CHAIN_ID=968
BOTCHAIN_TESTNET_EXPLORER_URL=https://scan.bohr.life
BOTCHAIN_TESTNET_FAUCET_URL=https://faucet.botchain.ai
BOTCHAIN_BUNDLER_URL=https://bundler.bohr.life/rpc/
BOTCHAIN_ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
BOTCHAIN_CONTRACT_DEPLOYMENT_BLOCK=24199338
BOTCHAIN_MAINNET_RPC_URL=https://rpc.botchain.ai
BOTCHAIN_MAINNET_CHAIN_ID=677
BOTCHAIN_MAINNET_EXPLORER_URL=https://scan.botchain.ai
BOTCHAIN_CONTRACT_ADDRESS=

# Persistence
DATABASE_URL=sqlite:///./backend/data/agentguard.db

# AI. llama.cpp is internal-only and serves Qwen3-4B-Instruct-2507 Q4_K_M.
AI_PROVIDER=llama_cpp
AI_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
OPENAI_API_KEY=
LOCAL_LLM_BASE_URL=http://llm:8080
LOCAL_LLM_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_THREADS=3
MODEL_TIMEOUT_SECONDS=60

# Caddy
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

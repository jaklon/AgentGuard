{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-X-Powered-By
		-Server
	}

	# This application has no Next.js Server Actions. Reject forged action IDs at
	# the edge so automated probes never reach the frontend runtime.
	@unknown_server_action header Next-Action *
	handle @unknown_server_action {
		respond 404
	}

	@api path /api/*
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:5173
		header {
			X-Frame-Options "DENY"
		}
	}

	log {
		output stdout
		format json
	}
}
